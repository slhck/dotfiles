# BEGIN: OS-specific configuration file

# Zsh config for Linux

# -----------------------------------------------
# Shell Aliases
# -----------------------------------------------

alias o='open'
alias open='xdg-open &>/dev/null'

# -----------------------------------------------
# Chained Aliases (Global, Linux specific)
# -----------------------------------------------

# Copy stdin to the local terminal's clipboard using an OSC 52 escape sequence
osc52copy() { printf '\e]52;c;%s\a' "$(base64 | tr -d '\n')" > /dev/tty }

if [[ -n $SSH_TTY ]]; then
    alias -g C='| osc52copy'
else
    alias -g C='| xclip -selection clipboard'
fi

# -----------------------------------------------
# Linuxbrew
# -----------------------------------------------

if [[ -d /home/linuxbrew/.linuxbrew/bin ]]; then
    export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
    export PATH="/home/linuxbrew/.linuxbrew/sbin:$PATH"
fi

# -----------------------------------------------
# zoxide (replaces autojump, use "j" command)
# -----------------------------------------------
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh --cmd j)"
fi

# END: OS-specific configuration file
