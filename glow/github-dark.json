{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "margin": 0, "color": "#c9d1d9", "background_color": "#010409" },
  "paragraph": { "color": "#c9d1d9" },
  "heading": { "block_suffix": "\n", "bold": true },
  "h1": { "color": "#58a6ff", "bold": true },
  "h2": { "color": "#bc8cff", "bold": true },
  "h3": { "color": "#79c0ff", "bold": true },
  "h4": { "color": "#d2a8ff", "bold": true },
  "h5": { "color": "#ffa657", "bold": true },
  "h6": { "color": "#8b949e", "bold": true },
  "block_quote": { "color": "#8b949e", "indent": 1, "indent_token": "│ " },
  "list": { "level_indent": 2 },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "strong": { "bold": true },
  "emph": { "italic": true, "color": "#d2a8ff" },
  "strikethrough": { "crossed_out": true, "color": "#8b949e" },
  "link": { "color": "#58a6ff", "underline": true },
  "link_text": { "color": "#58a6ff", "bold": true },
  "image": { "color": "#bc8cff", "underline": true },
  "image_text": { "color": "#8b949e", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#ffa657", "background_color": "#161b22" },
  "code_block": {
    "color": "#c9d1d9",
    "background_color": "#161b22",
    "margin": 0,
    "chroma": {
      "text": { "color": "#c9d1d9" },
      "comment": { "color": "#8b949e", "italic": true },
      "comment_preproc": { "color": "#ff7b72" },
      "keyword": { "color": "#ff7b72" },
      "keyword_reserved": { "color": "#ff7b72" },
      "keyword_namespace": { "color": "#d2a8ff" },
      "keyword_type": { "color": "#79c0ff" },
      "operator": { "color": "#ff7b72" },
      "punctuation": { "color": "#c9d1d9" },
      "name": { "color": "#c9d1d9" },
      "name_builtin": { "color": "#ffa657" },
      "name_tag": { "color": "#7ee787" },
      "name_attribute": { "color": "#79c0ff" },
      "name_class": { "color": "#ffa657" },
      "name_constant": { "color": "#79c0ff" },
      "name_decorator": { "color": "#d2a8ff" },
      "name_function": { "color": "#d2a8ff" },
      "literal_number": { "color": "#79c0ff" },
      "literal_string": { "color": "#a5d6ff" },
      "literal_string_escape": { "color": "#79c0ff" },
      "generic_deleted": { "color": "#f85149" },
      "generic_inserted": { "color": "#3fb950" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#8b949e" }
    }
  },
  "hr": { "color": "#30363d", "format": "\n────────\n" },
  "definition_description": { "block_prefix": "\n🠶 ", "color": "#8b949e" }
}
